<!-- ============ SCREEN: SUCCESS ============ -->
<section class="screen" id="screen-success">
  <main class="flow-main wrap">
    <div class="success-wrap">
      <div class="success-mark">✓</div>
      <div class="order-id" id="orderIdLine">Order #MBA-000000</div>
      <h1>Order Placed</h1>
      <p>Thanks for backing Drop 001. We'll verify your payment screenshot and confirm your order directly on the number you shared.</p>
      <div class="order-recap" id="orderRecap"></div>
      <button class="btn-primary" onclick="resetAndGoHome()">Back to Home</button>
    </div>
  </main>
</section>

<script>
  const FRONT_B64 = "";
  const BACK_B64 = "";
  const BASE_PRICE = 599;
  const UPI_PA = "9599602277@kotakbank";
  const UPI_PN = "SAAMARTH JAIN";
  const COUPON_CODE = "saamarth";
  const COUPON_DISCOUNT = 100;

  let qty = 1;
  let discount = 0;
  let couponLocked = false;
  let selectedSize = "M";
  let screenshotDataUrl = null;
  let screenshotFilename = "";

  function goTo(id){
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById('screen-' + id).classList.add('active');
    window.scrollTo({top:0, behavior:'smooth'});
  }

  function setMain(b64, el){
    document.getElementById('mainImg').src = "data:image/jpeg;base64," + b64;
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }

  document.querySelectorAll('.size-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.size-opt').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      selectedSize = opt.dataset.size;
    });
  });

  function changeQty(delta){
    qty = Math.max(1, Math.min(5, qty + delta));
    document.getElementById('qtyVal').textContent = qty;
    render();
  }

  function applyCoupon(){
    const val = document.getElementById('couponInput').value.trim().toLowerCase();
    const msg = document.getElementById('couponMsg');
    if(couponLocked){ return; }
    if(val === COUPON_CODE){
      discount = COUPON_DISCOUNT;
      couponLocked = true;
      msg.textContent = "✓ Coupon applied — ₹100 off";
      msg.className = "coupon-msg ok";
      document.getElementById('couponInput').disabled = true;
    } else {
      msg.textContent = "Invalid code. Try again.";
      msg.className = "coupon-msg err";
    }
    render();
  }

  function render(){
    const subtotal = BASE_PRICE * qty;
    const total = Math.max(0, subtotal - discount);

    document.getElementById('priceStrike').textContent = qty > 1 ? `₹${BASE_PRICE}×${qty}` : `₹${BASE_PRICE}`;
    document.getElementById('priceFinal').textContent = `₹${total}`;
    document.getElementById('saveBadge').classList.toggle('show', discount > 0);

    document.getElementById('sumQty').textContent = qty;
    document.getElementById('sumSubtotal').textContent = `₹${subtotal}`;
    document.getElementById('sumDiscountRow').style.display = discount > 0 ? 'flex' : 'none';
    document.getElementById('sumDiscount').textContent = `−₹${discount}`;
    document.getElementById('sumTotal').textContent = `₹${total}`;

    document.getElementById('sumQty2').textContent = qty;
    document.getElementById('sumSubtotal2').textContent = `₹${subtotal}`;
    document.getElementById('sumDiscountRow2').style.display = discount > 0 ? 'flex' : 'none';
    document.getElementById('sumDiscount2').textContent = `−₹${discount}`;
    document.getElementById('sumTotal2').textContent = `₹${total}`;
    document.getElementById('qrAmount').textContent = `₹${total}`;
  }

  function renderQR(){
    const subtotal = BASE_PRICE * qty;
    const total = Math.max(0, subtotal - discount);
    const qrDiv = document.getElementById('qrcode');
    qrDiv.innerHTML = "";
    const upiString = `upi://pay?pa=${UPI_PA}&pn=${encodeURIComponent(UPI_PN)}&am=${total}.00&cu=INR&tn=MBA%20Tee%20Order`;
    new QRCode(qrDiv, {
      text: upiString, width: 138, height: 138,
      colorDark: "#121210", colorLight: "#ffffff", correctLevel: QRCode.CorrectLevel.M
    });
  }

  function copyUpi(){
    navigator.clipboard.writeText(UPI_PA).then(() => {
      const btn = event.target;
      const old = btn.textContent;
      btn.textContent = "Copied";
      setTimeout(() => btn.textContent = old, 1500);
    });
  }

  function goToCheckout(){
    const printName = document.getElementById('printName').value.trim();
    if(!printName){
      alert("Please enter the name you'd like printed on the back.");
      return;
    }
    goTo('checkout');
  }

  function goToPayment(){
    const buyerName = document.getElementById('buyerName').value.trim();
    const buyerRoll = document.getElementById('buyerRoll').value.trim();
    const buyerPhone = document.getElementById('buyerPhone').value.trim();
    const buyerHostel = document.getElementById('buyerHostel').value.trim();
    const buyerRoom = document.getElementById('buyerRoom').value.trim();

    if(!buyerName || !buyerRoll || !buyerPhone || !buyerHostel || !buyerRoom){
      alert("Please fill in all fields before continuing.");
      return;
    }
    if(!/^\d{10}$/.test(buyerPhone)){
      alert("Please enter a valid 10-digit phone number.");
      return;
    }
    goTo('payment');
    renderQR();
  }

  function handleScreenshot(event){
    const file = event.target.files[0];
    if(!file) return;
    screenshotFilename = file.name;
    const reader = new FileReader();
    reader.onload = function(e){
      screenshotDataUrl = e.target.result;
      document.getElementById('previewImg').src = screenshotDataUrl;
      document.getElementById('uploadPreview').classList.add('show');
      document.getElementById('uploadText').textContent = "Tap to change screenshot";
      document.getElementById('uploadFilename').textContent = screenshotFilename;
      document.getElementById('uploadBox').classList.add('has-file');
    };
    reader.readAsDataURL(file);
  }

  function placeOrder(){
    if(!screenshotDataUrl){
      alert("Please upload your payment screenshot before confirming the order.");
      return;
    }

    const printName = document.getElementById('printName').value.trim();
    const buyerName = document.getElementById('buyerName').value.trim();
    const buyerRoll = document.getElementById('buyerRoll').value.trim();
    const buyerPhone = document.getElementById('buyerPhone').value.trim();
    const buyerHostel = document.getElementById('buyerHostel').value.trim();
    const buyerRoom = document.getElementById('buyerRoom').value.trim();

    const subtotal = BASE_PRICE * qty;
    const total = Math.max(0, subtotal - discount);
    const orderId = "MBA-" + Math.floor(100000 + Math.random() * 900000);

    document.getElementById('orderIdLine').textContent = "Order #" + orderId;

    const recap = document.getElementById('orderRecap');
    recap.innerHTML = `
      <div><span class="lbl">Item</span><span class="val">M.B.A Tee × ${qty} (${selectedSize})</span></div>
      <div><span class="lbl">Print Name</span><span class="val">${printName}</span></div>
      <div><span class="lbl">Buyer</span><span class="val">${buyerName}</span></div>
      <div><span class="lbl">Roll No.</span><span class="val">${buyerRoll}</span></div>
      <div><span class="lbl">Delivery</span><span class="val">${buyerHostel}, Room ${buyerRoom}</span></div>
      <div><span class="lbl">Phone</span><span class="val">${buyerPhone}</span></div>
      <div><span class="lbl">Amount Paid</span><span class="val">₹${total}</span></div>
    `;
    goTo('success');
  }

  function resetAndGoHome(){
    // reset flow state for a fresh order
    qty = 1; discount = 0; couponLocked = false; selectedSize = "M";
    screenshotDataUrl = null; screenshotFilename = "";
    document.getElementById('qtyVal').textContent = "1";
    document.getElementById('printName').value = "";
    document.getElementById('couponInput').value = ""; document.getElementById('couponInput').disabled = false;
    document.getElementById('couponMsg').className = "coupon-msg";
    document.getElementById('buyerName').value = ""; document.getElementById('buyerRoll').value = "";
    document.getElementById('buyerPhone').value = ""; document.getElementById('buyerHostel').value = "";
    document.getElementById('buyerRoom').value = "";
    document.getElementById('uploadPreview').classList.remove('show');
    document.getElementById('uploadBox').classList.remove('has-file');
    document.getElementById('uploadText').textContent = "Tap to upload your UPI payment screenshot";
    document.getElementById('screenshotInput').value = "";
    document.querySelectorAll('.size-opt').forEach(o => o.classList.remove('active'));
    document.querySelector('.size-opt[data-size="M"]').classList.add('active');
    render();
    goTo('landing');
  }

  render();
</script>

